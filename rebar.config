%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_news
%%
%% Layer-2 hecate-om service: a news sensor for the society. It polls sovereign
%% RSS/Atom sources (EU public broadcasters, open feeds — no Big-Tech news API),
%% dedupes, and publishes each fresh item as a news_item FACT onto the society's
%% <ns>/feed. The minds attend that feed; the sensor never reaches into the
%% society. Same pattern as hecate-warden: observe the world, publish facts.
%%
%% STORELESS BY DESIGN: no store_id/0 + data_dir/0, so hecate_om:boot/1 wires the
%% mesh but starts NO reckon-db. The sensor is a producer only.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK + realm identity + capabilities +
    %% health. No store_id/0 + data_dir/0 here, so this is a producer-only
    %% service. Brings macula (QUIC NIF) transitively. HTTPS to the sources uses
    %% pure OTP (inets + ssl + the system CA store) — no extra dep.
    {hecate_om, "~> 0.6"}
]}.

{project_plugins, [rebar3_ex_doc, rebar3_lint]}.

%% Elvis: the org's structural ruleset. No deep nesting (HARD, one level), no
%% nested try/catch, no if. Run via `rebar3 lint`.
{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => macula_min}
    ]}
]}.

{relx, [
    {release, {hecate_news, "0.1.0"}, [hecate_news, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.

{dialyzer, [
    {warnings, [no_unknown]},
    {exclude_apps, [
        macula, macula_envy, macula_mdns,
        reckon_db, reckon_evoq, reckon_gater, evoq,
        khepri, ra, horus, aten, seshat, gen_batch_server,
        gproc, msgpack, cowboy, ranch, jsx
    ]}
]}.

{shell, [{apps, [hecate_news]}]}.

{ex_doc, [
    {source_url, <<"https://codeberg.org/hecate-services/hecate-news">>},
    {extras, ["README.md", "CHANGELOG.md", "LICENSE"]},
    {main, "README.md"}
]}.
