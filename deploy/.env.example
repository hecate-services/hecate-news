# hecate-news drop-in configuration.  cp .env.example .env  and fill in.
# Full reference: docs/INTEGRATION.md#environment-reference

# --- the society whose feed you publish to ---
# The minds of this society attend <ns>/feed. Default: news.
HECATE_SOCIETY=news

# --- the commons you join (given to you; not secrets) ---
# The 64-hex realm (topic scope everyone in this commons shares).
HECATE_REALM=074acb6cb190d8ef79fdbdd8e8e76d53f6292c181fd23f4d3998560f9a94e8e3
# A station URL to reach the mesh.
MACULA_STATION_SEEDS=https://station-de-frankfurt.macula.io:4433

# --- what to poll ---
# Leave HECATE_NEWS_FEEDS empty to use the built-in EU defaults (France 24,
# VRT NWS, Deutsche Welle). To override: "name|url|lang,name|url|lang"
#   HECATE_NEWS_FEEDS=euractiv|https://www.euractiv.com/feed/|en,rtbf|https://rss.rtbf.be/article/rss/highlight_rtbfinfo_info.xml|fr
HECATE_NEWS_FEEDS=
# How often to poll every source, in ms (default 5 min).
HECATE_NEWS_POLL_MS=300000
# Newest-N per source published on the first poll; the rest are primed as seen.
HECATE_NEWS_SEED_COUNT=1
# Bounded dedupe window (recent item ids remembered).
HECATE_NEWS_MAX_SEEN=4000

# --- the realm service-principal cert for this sensor ---
# Directory holding service-cert.pem, mounted read-only into the container.
HECATE_SECRETS_DIR=./secrets
